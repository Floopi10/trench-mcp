{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trench-mcp",
  "compatibility_date": "2026-09-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "docs",
    "binding": "ASSETS",
    "run_worker_first": [
      "/mcp",
      "/health",
      "/api/analyze",
      "/api/markets"
    ]
  },
  "main": "src/worker.mjs",
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1010",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
